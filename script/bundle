#!/usr/bin/env bash

OS_TYPE="$(uname -s)"

if [[ "$OS_TYPE" = "Darwin" ]]; then
  ./script/macos/bundle "$@"
elif [[ "$OS_TYPE" = "Linux" ]]; then
  ./script/linux/bundle "$@"
elif [[ "$OS_TYPE" =~ ^(MINGW64_NT|MSYS_NT) ]]; then
  PARAMS=()
  while (( "$#" )); do
    case "$1" in
      --debug) PARAMS+=(-DEBUG_BUILD) ;;
      --nouniversal) ;; # Only relevant to macOS bundles.
      *) PARAMS+=("${1/#--/-}") ;;
    esac
    shift
  done
  powershell.exe -NoProfile -File ./script/windows/bundle.ps1 "${PARAMS[@]}"
else
  echo "No bundle script defined for the current platform ($OS_TYPE)!" >&2
  exit 1
fi
