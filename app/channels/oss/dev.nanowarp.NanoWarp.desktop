[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=NanoWarp
GenericName=TerminalEmulator

Exec=nanowarp %U
StartupWMClass=dev.nanowarp.NanoWarp

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.nanowarp.NanoWarp

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for nanowarp:// URLs.
MimeType=x-scheme-handler/nanowarp;
